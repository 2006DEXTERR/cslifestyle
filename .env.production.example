# ─────────────────────────────────────────────────────────────
# CSLifestyle production stack (docker-compose.prod.yml --env-file .env.production)
# Copy to `.env.production` and fill in REAL secrets. NEVER commit the real file.
# ─────────────────────────────────────────────────────────────

# Database (the compose Postgres service uses these; the api/worker use DATABASE_URL)
POSTGRES_USER=cslifestyle
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=cslifestyle
DATABASE_URL=postgresql://cslifestyle:CHANGE_ME_strong_db_password@postgres:5432/cslifestyle?schema=public

# Redis (in-cluster)
REDIS_URL=redis://redis:6379

# Public URLs
APP_URL=https://cslifestyle.in
CORS_ORIGIN=https://cslifestyle.in

# Secrets — REQUIRED in production (must each be >= 32 chars)
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_random_secret
ENCRYPTION_KEY=CHANGE_ME_at_least_32_characters_random_key__

# Cookies (secure flags for HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.cslifestyle.in

# Distributed rate limiting across instances
RATE_LIMIT_REDIS=true

# Admin seed (first boot)
SEED_ADMIN_EMAIL=admin@cslifestyle.in
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Email (Resend) — leave blank to log instead of send
RESEND_API_KEY=
EMAIL_FROM=CSLifestyle <hello@cslifestyle.in>

# Optional external providers (leave blank to stay in offline/mock mode)
AI_DRIVER=mock
ANALYTICS_DRIVER=mock
# ANTHROPIC_API_KEY=
# GA4_MEASUREMENT_ID=
# GA4_API_SECRET=
# POSTHOG_API_KEY=

# Media uploads are written here (a persistent volume is mounted at this path)
UPLOAD_DIR=/data/uploads
