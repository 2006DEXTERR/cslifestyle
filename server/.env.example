# ─────────────────────────────────────────────────────────────
# CSLifestyle backend — environment variables
# Copy to `.env` and adjust. Validated by zod at boot (src/config/env.ts).
# In production, DATABASE_URL and REDIS_URL are REQUIRED (no defaults).
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# CORS — comma-separated origins allowed to call the API (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://cslifestyle:cslifestyle@localhost:5432/cslifestyle?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Frontend base URL (used in email verification / password reset links)
APP_URL=http://localhost:3000

# Auth / JWT  (REQUIRED in production; JWT_ACCESS_SECRET must be >= 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32+chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
BCRYPT_ROUNDS=12
TOKEN_PEPPER=

# AES-256-GCM key for encrypting 2FA secrets at rest (>= 32 chars; REQUIRED in production)
ENCRYPTION_KEY=dev-encryption-key-change-me-32-bytes-minimum!!

# Two-factor authentication
TWO_FACTOR_ISSUER=CSLifestyle
BACKUP_CODES_COUNT=10
TWO_FACTOR_CHALLENGE_TTL=5m

# Email (Resend) — leave RESEND_API_KEY blank to log emails instead of sending
RESEND_API_KEY=
EMAIL_FROM=CSLifestyle <onboarding@resend.dev>
EMAIL_MAX_RETRIES=3

# Rate limiting (true = distributed Redis store; false = in-memory per instance)
RATE_LIMIT_REDIS=false

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.cslifestyle.in

# Seed (optional — defaults used if unset)
SEED_ADMIN_EMAIL=admin@cslifestyle.in
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=CSLifestyle Admin

# ── Background jobs / queues (Phase 6+, ADR-023) ──
# inline = process jobs in-process (dev/test, no Redis needed).
# bullmq = enqueue to Redis-backed queues (production; run the worker process).
QUEUE_DRIVER=inline

# ── AI content engine (Phase 7, ADR-024) ──
# mock = deterministic, offline, zero-cost (dev/test/CI). live = call real providers.
AI_DRIVER=mock
AI_PRIMARY_PROVIDER=anthropic
AI_CONCURRENCY=4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# ── Analytics & reporting (Phase 8, ADR-025) ──
# mock = no external dispatch (dev/test/CI). live = forward to configured providers.
ANALYTICS_DRIVER=mock
ANALYTICS_RETENTION_DAYS=180
REVENUE_DEFAULT_CVR=0.04
REVENUE_DEFAULT_COMMISSION=0.05
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GSC_SITE_URL=

# ── Marketing & communication (Phase 9, ADR-026) ──
# Uses the same email provider as auth (Resend → console fallback above).
NEWSLETTER_DOUBLE_OPT_IN=true
MARKETING_FROM_NAME=CSLifestyle
CAMPAIGN_BATCH_SIZE=100

# ── Media Library (Phase 10, ADR-027) ──
# UPLOAD_DIR: where uploaded files are stored (mount a persistent volume in prod).
# MEDIA_BASE_URL: '' → same-origin /uploads.
UPLOAD_DIR=uploads
MEDIA_BASE_URL=
MEDIA_MAX_FILE_MB=10
