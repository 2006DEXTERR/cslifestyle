# ─────────────────────────────────────────────────────────────
# CSLifestyle backend — environment variables
# Copy to `.env` and adjust. Validated by zod at boot (src/config/env.ts).
# In production, DATABASE_URL and REDIS_URL are REQUIRED (no defaults).
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# CORS — comma-separated origins allowed to call the API (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://cslifestyle:cslifestyle@localhost:5432/cslifestyle?schema=public

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Frontend base URL (used in email verification / password reset links)
APP_URL=http://localhost:3000

# Auth / JWT  (REQUIRED in production; JWT_ACCESS_SECRET must be >= 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32+chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
BCRYPT_ROUNDS=12
TOKEN_PEPPER=

# AES-256-GCM key for encrypting 2FA secrets at rest (>= 32 chars; REQUIRED in production)
ENCRYPTION_KEY=dev-encryption-key-change-me-32-bytes-minimum!!

# Two-factor authentication
TWO_FACTOR_ISSUER=CSLifestyle
BACKUP_CODES_COUNT=10
TWO_FACTOR_CHALLENGE_TTL=5m

# Email (Resend) — leave RESEND_API_KEY blank to log emails instead of sending
RESEND_API_KEY=
EMAIL_FROM=CSLifestyle <onboarding@resend.dev>
EMAIL_MAX_RETRIES=3

# Rate limiting (true = distributed Redis store; false = in-memory per instance)
RATE_LIMIT_REDIS=false

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.cslifestyle.in

# Seed (optional — defaults used if unset)
SEED_ADMIN_EMAIL=admin@cslifestyle.in
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=CSLifestyle Admin
