{
  "name": "cslifestyle-server",
  "version": "0.1.0",
  "private": true,
  "description": "CSLifestyle backend — Node.js + Express + TypeScript + PostgreSQL/Prisma + Redis/BullMQ",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/jobs/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/jobs/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "products:list": "tsx scripts/list-products.ts",
    "products:template": "tsx scripts/generate-template.ts",
    "products:quick-template": "tsx scripts/quick-template.ts",
    "products:validate": "tsx scripts/bulk-update-products.ts --validate",
    "products:bulk": "tsx scripts/bulk-update-products.ts",
    "guides:fix-images": "tsx scripts/fix-guide-images.ts",
    "categories:fix-images": "tsx scripts/fix-category-images.ts",
    "products:fetch-amazon": "tsx scripts/fetch-amazon-products.ts",
    "products:apply-amazon-review": "tsx scripts/apply-amazon-review.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/multer": "^2.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "ioredis": "5.10.1"
  }
}
