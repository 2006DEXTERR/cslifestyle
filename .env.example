# ─────────────────────────────────────────────────────────────
# CSLifestyle frontend (Next.js) — environment variables
# Copy to `.env.local` for local dev. The frontend proxies /api/* and /uploads/*
# to the Express backend (server-to-server) via next.config.js rewrites.
# ─────────────────────────────────────────────────────────────

# Absolute origin of the Express backend (used by the rewrites + SSR fetchers).
# Use 127.0.0.1 (not "localhost") so the dev proxy doesn't resolve to IPv6 ::1 and
# miss the IPv4-bound backend on Windows.
BACKEND_ORIGIN=http://127.0.0.1:4000
